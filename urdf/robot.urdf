<?xml version="1.0"?>
<robot name="four_wheel_steering_robot">

  <!-- materials -->
  <material name="chassis_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="knuckle_silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="wheel_dark">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- base_footprint (massless root link) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- base_link (chassis) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.066" ixy="0.0" ixz="0.0" iyy="0.173" iyz="0.0" izz="0.226"/>
    </inertial>
  </link>

  <!-- FRONT LEFT -->
  <!-- fl knuckle joint -->
  <joint name="fl_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="fl_knuckle_link"/>
    <origin xyz="0.18 0.18 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="15.0" velocity="2.0"/>
  </joint>

  <link name="fl_knuckle_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
      <material name="knuckle_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00012" ixy="0.0" ixz="0.0" iyy="0.00012" iyz="0.0" izz="0.00006"/>
    </inertial>
  </link>

  <!-- fl wheel joint -->
  <joint name="fl_wheel_joint" type="continuous">
    <parent link="fl_knuckle_link"/>
    <child link="fl_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="fl_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.00104" ixy="0.0" ixz="0.0" iyy="0.00192" iyz="0.0" izz="0.00104"/>
    </inertial>
  </link>

  <!-- FRONT RIGHT -->
  <!-- fr knuckle joint -->
  <joint name="fr_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="fr_knuckle_link"/>
    <origin xyz="0.18 -0.18 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="15.0" velocity="2.0"/>
  </joint>

  <link name="fr_knuckle_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
      <material name="knuckle_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00012" ixy="0.0" ixz="0.0" iyy="0.00012" iyz="0.0" izz="0.00006"/>
    </inertial>
  </link>

  <!-- fr wheel joint -->
  <joint name="fr_wheel_joint" type="continuous">
    <parent link="fr_knuckle_link"/>
    <child link="fr_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="fr_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.00104" ixy="0.0" ixz="0.0" iyy="0.00192" iyz="0.0" izz="0.00104"/>
    </inertial>
  </link>

  <!-- REAR LEFT -->
  <!-- rl knuckle joint -->
  <joint name="rl_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rl_knuckle_link"/>
    <origin xyz="-0.18 0.18 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="15.0" velocity="2.0"/>
  </joint>

  <link name="rl_knuckle_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
      <material name="knuckle_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00012" ixy="0.0" ixz="0.0" iyy="0.00012" iyz="0.0" izz="0.00006"/>
    </inertial>
  </link>

  <!-- rl wheel joint -->
  <joint name="rl_wheel_joint" type="continuous">
    <parent link="rl_knuckle_link"/>
    <child link="rl_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rl_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.00104" ixy="0.0" ixz="0.0" iyy="0.00192" iyz="0.0" izz="0.00104"/>
    </inertial>
  </link>

  <!-- REAR RIGHT -->
  <!-- rr knuckle joint -->
  <joint name="rr_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rr_knuckle_link"/>
    <origin xyz="-0.18 -0.18 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="15.0" velocity="2.0"/>
  </joint>

  <link name="rr_knuckle_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
      <material name="knuckle_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00012" ixy="0.0" ixz="0.0" iyy="0.00012" iyz="0.0" izz="0.00006"/>
    </inertial>
  </link>

  <!-- rr wheel joint -->
  <joint name="rr_wheel_joint" type="continuous">
    <parent link="rr_knuckle_link"/>
    <child link="rr_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rr_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.00104" ixy="0.0" ixz="0.0" iyy="0.00192" iyz="0.0" izz="0.00104"/>
    </inertial>
  </link>

</robot>
