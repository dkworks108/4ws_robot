<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Macro for steering knuckle assembly -->
  <xacro:macro name="steering_assembly" params="prefix parent x y z">
    <joint name="${prefix}_steering_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${prefix}_knuckle_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57079632679" upper="1.57079632679" effort="25.0" velocity="4.0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <link name="${prefix}_knuckle_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.06"/>
        </geometry>
        <material name="knuckle_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.06"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.00012" ixy="0.0" ixz="0.0" 
                 iyy="0.00012" iyz="0.0" 
                 izz="0.00006"/>
      </inertial>
    </link>

    <gazebo reference="${prefix}_knuckle_link">
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

</robot>
