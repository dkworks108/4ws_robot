<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>four_wheel_navigation</name>
  <version>1.0.0</version>
  <description>SLAM Toolbox and Navigation2 configurations for Four-Wheel Steering Robot.</description>
  <maintainer email="robotics@example.com">ROS 2 Developer</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>slam_toolbox</depend>
  <depend>nav2_bringup</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_amcl</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
