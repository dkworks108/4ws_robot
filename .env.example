# 4ws_robot Example Environment Configuration
# Copy to .env for local overrides (never commit .env or real credentials).

# Local Web Dashboard & ROS Bridge Ports
WEB_PORT=3000
ROSBRIDGE_PORT=9090
WEB_VIDEO_PORT=8080

# Optional ROS Overlay & Local Artifact Export Directory
ROS_EXTRA_OVERLAY=
SCREENSHOT_ARTIFACT_DIR=

# Dubant Control & Server Integration (BETA / IN DEVELOPMENT - NOT ACTIVE IN CURRENT BUILD)
# Leave blank for local LAN simulation operation.
DUBANT_SERVER_URL=
DUBANT_AUTH_TOKEN=
DUBANT_ROBOT_ID=

